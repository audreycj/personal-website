---
// ==========================================================
// BASE LAYOUT: wraps every page (head, nav, footer, shared scripts)
// ==========================================================
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props { title?: string; description?: string; cozy?: boolean; journal?: boolean }
const { title, description = site.description, cozy = false, journal = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.jobTitle}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const shareImage = new URL('/og.png', site.url).href;
// "Person" data for search engines: who this site belongs to, and their other profiles
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.otherNames,
  url: site.url,
  image: shareImage,
  jobTitle: site.jobTitle,
  worksFor: { '@type': 'CollegeOrUniversity', name: site.employer },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Mapúa Malayan Colleges Mindanao' },
    { '@type': 'CollegeOrUniversity', name: 'Silliman University' },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Mati City', addressRegion: 'Davao Oriental', addressCountry: 'PH' },
  sameAs: site.links.map((l) => l.url),
};
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// "next up" link: the tab after this one in the nav (home has its own links)
const here = nav.findIndex((n) => n.href !== '/' && (path === n.href || path.startsWith(n.href + '/')));
const nextTab = here >= 0 ? nav[here + 1] : undefined;
const isLastTab = here === nav.length - 1;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap.xml" />

  <!-- link previews (Messenger, LinkedIn, Discord, etc.) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Kalam:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body class={cozy ? 'is-cozy' : journal ? 'is-journal' : ''}>
  <!-- line-boil filters: slow wobble + fine crayon roughness. JS below cycles them. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      {[[1, 3], [7, 9], [13, 15]].map(([a, b], i) => (
        <filter id={`boil${i}`}>
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed={a} result="w" />
          <feDisplacementMap in="SourceGraphic" in2="w" scale="4" result="d" />
          <feTurbulence type="fractalNoise" baseFrequency="0.7" seed={b} result="c" />
          <feDisplacementMap in="d" in2="c" scale="2.5" />
        </filter>
      ))}
    </defs>
  </svg>

  <header class="wrap top">
    {cozy
      ? <a href="/" class="brand">← back to the professional stuff</a>
      : path === '/'
        ? <span class="brand" aria-hidden="true"></span>
        : <a href="/" class="brand" aria-label="Audrey Nanual, home">
            <img src="/favicon.svg" alt="" width="44" height="33" class="brand-cat" />
          </a>}
    {!cozy && (
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class:list={[{ active: path === item.href || (item.href !== '/' && path.startsWith(item.href + '/')) }, { special: item.special }]}>
            {item.special && <span aria-hidden="true">✦ </span>}{item.label}
          </a>
        ))}
      </nav>
    )}
  </header>

  <main>
    <slot />
  </main>

  {!cozy && nextTab && (
    <div class="wrap next-up">
      <a href={nextTab.href}>next up: <b>{nextTab.label}</b> →</a>
    </div>
  )}
  {!cozy && isLastTab && (
    <div class="wrap next-up">
      <a href="/cozy" data-wipe>that's the story so far. <b>follow the yarn to the cozy side</b> →</a>
    </div>
  )}

  <footer class="wrap foot">
    {path !== '/contact' && <>
      <p class="foot-hello"><a href="/contact">say hi!</a></p>
      <p class="foot-links">
        <a href="/contact">send me a message</a>
        {site.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
      </p>
    </>}
    <p class="foot-small">© {new Date().getFullYear()} {site.fullName}<span class="sep">•</span>made with too many cat doodles</p>
  </footer>

  <script>
    // 1) line boil: swap the three filters ~8 times a second
    let i = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) setInterval(() => {
      i = (i + 1) % 3;
      document.documentElement.style.setProperty('--boil', `url(#boil${i})`);
    }, 130);

    // 2) cat eyes follow the cursor
    addEventListener('pointermove', (e) => {
      document.querySelectorAll<SVGEllipseElement>('.cat .pupil').forEach((p) => {
        const svg = p.ownerSVGElement!;
        const r = svg.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return; // skip cats off screen
        const s = r.width / 240;
        const cx = r.left + p.cx.baseVal.value * s, cy = r.top + p.cy.baseVal.value * s;
        const a = Math.atan2(e.clientY - cy, e.clientX - cx);
        const d = Math.min(5, Math.hypot(e.clientX - cx, e.clientY - cy) / 40);
        p.setAttribute('transform', `translate(${Math.cos(a) * d} ${Math.sin(a) * d})`);
      });
    });

    // 3) pop things in as they scroll into view
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // 4) circle-wipe page transition for links marked data-wipe
    document.querySelectorAll<HTMLAnchorElement>('a[data-wipe]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (reduce) return;
        e.preventDefault();
        const r = a.getBoundingClientRect();
        const w = document.createElement('div');
        w.className = 'wipe';
        w.style.setProperty('--x', `${r.left + 20}px`);
        w.style.setProperty('--y', `${r.top + r.height / 2}px`);
        document.body.appendChild(w);
        requestAnimationFrame(() => requestAnimationFrame(() => w.classList.add('open')));
        setTimeout(() => { location.href = a.href; }, 650);
      });
    });
    // undo the wipe if the person comes back with the browser's back button
    addEventListener('pageshow', () => document.querySelectorAll('.wipe').forEach((w) => w.remove()));
  </script>
</body>
</html>

<style>
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand-cat { display: block; transition: transform .3s cubic-bezier(.3,2,.5,1); }
  .brand:hover .brand-cat { transform: rotate(-12deg) scale(1.12); }
  .top {
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    padding-top: 30px; font-family: var(--font-display); font-weight: 600; font-size: 18px;
  }
  .top nav { display: flex; gap: 4px; flex-wrap: wrap; }
  .top nav a { padding: 4px 14px; border-radius: 999px; transition: background .2s, color .2s; }
  .top nav a:hover, .top nav a.active { background: var(--ink); color: var(--pink-soft); }
  /* the Journey tab: a cream sticker, like "part-time cat butler" on the home page */
  .top nav a.special {
    background: var(--cream); border: 2.5px solid var(--ink); transform: rotate(-3deg); margin-left: 6px;
    box-shadow: 3px 3px 0 var(--ink); transition: transform .3s cubic-bezier(.3,1.8,.5,1), box-shadow .2s;
  }
  .top nav a.special:hover { transform: rotate(2deg) scale(1.06); background: var(--cream); color: var(--ink); }
  .top nav a.special.active { background: var(--ink); color: var(--cream); }

  /* the Journey page: journal paper (cream with a faint grid), same ink and accents */
  .is-journal {
    background-color: #fbf3e8;
    background-image:
      linear-gradient(rgba(150, 170, 200, .18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(150, 170, 200, .18) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .next-up { text-align: center; margin-top: 80px; font-size: 23px; }
  .next-up a { display: inline-block; padding: 10px 24px; border: 3px dashed var(--ink); border-radius: 999px; transition: transform .3s cubic-bezier(.3,1.8,.5,1); }
  .next-up a:hover { transform: rotate(-2deg) scale(1.04); border-style: solid; background: var(--paper); }
  .next-up b { text-decoration: underline wavy; text-underline-offset: 5px; }
  .is-cozy { background: var(--cream) radial-gradient(#ecc6cf 2px, transparent 2px) 0 0 / 30px 30px; }

  main { min-height: 70vh; }

  .foot { text-align: center; padding-top: 90px; padding-bottom: 50px; }
  .foot-hello { font-family: var(--font-display); font-weight: 700; font-size: 34px; }
  .foot-links { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 21px; margin-top: 4px; }
  .foot-links a { text-decoration: underline wavy; text-underline-offset: 5px; }
  .foot-small { font-size: 16px; opacity: .7; margin-top: 18px; }
</style>
