---
// ==========================================================
// BASE LAYOUT: wraps every page (head, nav, footer, shared scripts)
// ==========================================================
import '../styles/global.css';
import Cat from '../components/Cat.astro';
import { site, nav } from '../data/site';

interface Props { title?: string; description?: string; cozy?: boolean }
const { title, description = site.description, cozy = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Kalam:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body class={cozy ? 'is-cozy' : ''}>
  <!-- line-boil filters: slow wobble + fine crayon roughness. JS below cycles them. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      {[[1, 3], [7, 9], [13, 15]].map(([a, b], i) => (
        <filter id={`boil${i}`}>
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed={a} result="w" />
          <feDisplacementMap in="SourceGraphic" in2="w" scale="4" result="d" />
          <feTurbulence type="fractalNoise" baseFrequency="0.7" seed={b} result="c" />
          <feDisplacementMap in="d" in2="c" scale="2.5" />
        </filter>
      ))}
    </defs>
  </svg>

  <header class="wrap top">
    {cozy
      ? <a href="/" class="brand">← back to the professional stuff</a>
      : <a href="/" class="brand">audrey nanual</a>}
    {!cozy && (
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} class={path === item.href ? 'active' : ''}>{item.label}</a>
        ))}
      </nav>
    )}
  </header>

  <main>
    <slot />
  </main>

  <footer class="wrap foot">
    <div class="foot-cats" aria-hidden="true">
      <Cat coat="cream" size={64} />
      <Cat coat="calico" size={64} />
      <Cat coat="gray" size={64} />
    </div>
    <p class="foot-hello">say hi!</p>
    <p class="foot-links">
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
      {site.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
    </p>
    <p class="foot-small">© {new Date().getFullYear()} {site.name} · handmade with too many cat doodles</p>
  </footer>

  <script>
    // 1) line boil: swap the three filters ~8 times a second
    let i = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) setInterval(() => {
      i = (i + 1) % 3;
      document.documentElement.style.setProperty('--boil', `url(#boil${i})`);
    }, 130);

    // 2) cat eyes follow the cursor
    addEventListener('pointermove', (e) => {
      document.querySelectorAll<SVGEllipseElement>('.cat .pupil').forEach((p) => {
        const svg = p.ownerSVGElement!;
        const r = svg.getBoundingClientRect();
        if (r.bottom < 0 || r.top > innerHeight) return; // skip cats off screen
        const s = r.width / 240;
        const cx = r.left + p.cx.baseVal.value * s, cy = r.top + p.cy.baseVal.value * s;
        const a = Math.atan2(e.clientY - cy, e.clientX - cx);
        const d = Math.min(5, Math.hypot(e.clientX - cx, e.clientY - cy) / 40);
        p.setAttribute('transform', `translate(${Math.cos(a) * d} ${Math.sin(a) * d})`);
      });
    });

    // 3) pop things in as they scroll into view
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // 4) circle-wipe page transition for links marked data-wipe
    document.querySelectorAll<HTMLAnchorElement>('a[data-wipe]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (reduce) return;
        e.preventDefault();
        const r = a.getBoundingClientRect();
        const w = document.createElement('div');
        w.className = 'wipe';
        w.style.setProperty('--x', `${r.left + 20}px`);
        w.style.setProperty('--y', `${r.top + r.height / 2}px`);
        document.body.appendChild(w);
        requestAnimationFrame(() => requestAnimationFrame(() => w.classList.add('open')));
        setTimeout(() => { location.href = a.href; }, 650);
      });
    });
    // undo the wipe if the person comes back with the browser's back button
    addEventListener('pageshow', () => document.querySelectorAll('.wipe').forEach((w) => w.remove()));
  </script>
</body>
</html>

<style>
  .top {
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    padding-top: 30px; font-family: var(--font-display); font-weight: 600; font-size: 18px;
  }
  .top nav { display: flex; gap: 4px; flex-wrap: wrap; }
  .top nav a { padding: 4px 14px; border-radius: 999px; transition: background .2s, color .2s; }
  .top nav a:hover, .top nav a.active { background: var(--ink); color: var(--pink-soft); }
  .is-cozy { background: var(--cream) radial-gradient(#ecc6cf 2px, transparent 2px) 0 0 / 30px 30px; }

  main { min-height: 70vh; }

  .foot { text-align: center; padding-top: 110px; padding-bottom: 50px; }
  .foot-cats { display: flex; justify-content: center; gap: 6px; margin-bottom: 6px; }
  .foot-hello { font-family: var(--font-display); font-weight: 700; font-size: 34px; }
  .foot-links { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 21px; margin-top: 4px; }
  .foot-links a { text-decoration: underline wavy; text-underline-offset: 5px; }
  .foot-small { font-size: 16px; opacity: .7; margin-top: 18px; }
</style>
