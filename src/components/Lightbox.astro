---
// ==========================================================
// LIGHTBOX: clicking any element with data-zoom="<image url>"
// opens that image full-size. Put <Lightbox /> once on a page.
//   several images: data-zoom="/a.webp|/b.webp" (arrows to flip through)
//   a caption:      data-caption="..."
// Click the image itself to see it at full size (scroll to read).
// ==========================================================
---
<dialog class="lightbox" id="lightbox" aria-label="Image preview">
  <button type="button" class="close" aria-label="Close">✕</button>
  <div class="frame"><img alt="" title="Click to zoom" /></div>
  <div class="nav" hidden>
    <button type="button" class="prev" aria-label="Previous image">←</button>
    <span class="count"></span>
    <button type="button" class="next" aria-label="Next image">→</button>
  </div>
  <p class="cap"></p>
</dialog>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement;
  const frame = box.querySelector('.frame') as HTMLElement;
  const img = box.querySelector('img')!;
  const cap = box.querySelector('.cap') as HTMLElement;
  const nav = box.querySelector('.nav') as HTMLElement;
  const count = box.querySelector('.count') as HTMLElement;
  let list: string[] = [];
  let at = 0;

  const show = (i: number) => {
    at = (i + list.length) % list.length;
    img.src = list[at];
    frame.classList.remove('big');
    frame.scrollTop = 0;
    count.textContent = `${at + 1} / ${list.length}`;
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
    if (!t) return;
    list = t.dataset.zoom!.split('|');
    img.alt = t.querySelector('img')?.alt ?? '';
    cap.textContent = t.dataset.caption ?? '';
    cap.hidden = !t.dataset.caption;
    nav.hidden = list.length < 2;
    show(0);
    box.showModal();
  });

  box.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    if (e.target === box || el.closest('.close')) box.close();
    else if (el.closest('.prev')) show(at - 1);
    else if (el.closest('.next')) show(at + 1);
    else if (el === img) frame.classList.toggle('big'); // zoom in / out
  });
  box.addEventListener('keydown', (e) => {
    if (list.length < 2) return;
    if (e.key === 'ArrowLeft') show(at - 1);
    if (e.key === 'ArrowRight') show(at + 1);
  });
</script>

<style>
  .lightbox {
    position: fixed; inset: 0; margin: auto; /* the global reset removes the dialog's built-in centering */
    max-width: min(1200px, 94vw); max-height: 92vh; padding: 28px; border: 3px solid var(--ink); border-radius: 18px;
    background: var(--paper); box-shadow: 8px 8px 0 var(--ink); overflow: visible;
  }
  .lightbox::backdrop { background: rgba(61, 26, 34, .55); }
  .frame { max-height: calc(92vh - 130px); overflow: auto; border-radius: 8px; }
  .frame img { display: block; max-width: 100%; max-height: calc(92vh - 130px); margin: 0 auto; cursor: zoom-in; }
  .frame.big img { max-height: none; max-width: none; width: min(1100px, 100%); cursor: zoom-out; }
  .nav { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 12px; }
  .nav[hidden] { display: none; }
  .nav button {
    width: 40px; height: 40px; border-radius: 50%; background: var(--butter); border: 2.5px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink); font-size: 18px; font-weight: 700; cursor: pointer;
  }
  .count { font-family: var(--font-display); font-weight: 600; font-size: 15px; }
  .cap { font-size: 17px; text-align: center; margin: 12px 8px 0; font-style: italic; opacity: .8; }
  .close {
    position: absolute; top: -16px; right: -16px; width: 40px; height: 40px; border-radius: 50%;
    background: var(--butter); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); font-size: 18px; font-weight: 700;
  }
</style>
