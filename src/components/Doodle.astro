const body = ICONS[name] ?? ICONS.sparkle;
---
<svg class={`doodle boil ${cls}`} width={size} height={size} viewBox="0 0 80 80" style={`--c: var(--${color})`} aria-hidden="true" set:html={body}></svg>

<style is:global>
  .doodle * { stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .doodle .m, .doodle .m * { fill: var(--c); }
  .doodle .p { fill: var(--paper); }
  .doodle .k { fill: var(--ink); }
  .doodle .a1 { fill: var(--butter); }
  .doodle .a2 { fill: #f4a9b8; }
  .doodle .n { fill: none; }
  .doodle .w { fill: none; stroke: #fff; stroke-width: 2.5; }
  .doodle g { fill: var(--c); }
</style>
