---
import Base from '../layouts/Base.astro';
import Cat from '../components/Cat.astro';
import Doodle from '../components/Doodle.astro';
import { site, bandItems } from '../data/site';
import { projects } from '../data/projects';
import { chapters } from '../data/journey';
import { certGroups, awards } from '../data/credentials';

const certCount = certGroups.reduce((n, g) => n + g.certs.length, 0);
const chapterDoodles = ['backpack', 'boat', 'laptop', 'phone', 'chalkboard'];
const chapterColors = ['peach', 'sky', 'lilac', 'sage', 'butter'];
---
<Base>
  <div class="wrap">
    <!-- HERO -->
    <section class="hero">
      <div>
        <h1 class="split">Audrey<br />Nanual</h1>
        <p class="sub">{site.title}, <em>{site.tagline}</em></p>
      </div>
      <div class="catbox" id="bigcat">
        <Doodle name="sparkle" color="butter" size={44} class="spark s1" />
        <Doodle name="sparkle" color="sage" size={34} class="spark s2" />
        <Doodle name="sparkle" color="lilac" size={26} class="spark s3" />
        <div class="bubble">mrrp!</div>
        <Cat coat="tabby" size={300} />
        <div class="hint">(boop it)</div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="about">
      <div class="sticker bio-card reveal">
        <span class="tape"></span>
        <div class="label">hello, a bit about me</div>
        <p class="bio">
          I teach at <mark style="--c:var(--sage)">Davao Oriental State University</mark> and I'm taking my
          <mark style="--c:var(--butter)">Master's in IT</mark>. Before teaching I did
          <mark style="--c:var(--lilac)">UI/UX design</mark> and <mark style="--c:var(--peach)">data analytics</mark>.
          Lately I've been exploring what I can make on my own, starting with a Discord bot for my classes and this very website.
        </p>
      </div>
      <div class="facts">
        <div class="fact" style="--c:var(--sage)"><Doodle name="gradcap" color="sage" size={40} /> teaching BSIT</div>
        <div class="fact" style="--c:var(--butter)"><Doodle name="laptop" color="butter" size={40} /> making my own tools</div>
        <div class="fact" style="--c:var(--peach)"><Doodle name="paw" color="peach" size={40} /> cat rescuer</div>
      </div>
    </section>
  </div>

  <!-- SCROLLING BAND -->
  <div class="band" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => <span>{bandItems.map((t) => <>{t}<b>✦</b></>)}</span>)}
    </div>
  </div>

  <div class="wrap">
    <!-- JOURNEY TEASER -->
    <h2 class="section-title">the journey so far <Doodle name="sparkle" color="butter" size={30} /></h2>
    <a href="/journey" class="journey-teaser sticker reveal">
      <div class="trail">
        {chapters.map((ch, i) => (
          <div class="stop">
            <Doodle name={chapterDoodles[i]} color={chapterColors[i]} size={70} />
            <span class="ch-num">ch. {ch.number}</span>
            <span class="ch-title">{ch.title}</span>
          </div>
        ))}
      </div>
      <span class="btn" style="--c:var(--butter)">walk the path →</span>
    </a>

    <!-- PROJECTS -->
    <h2 class="section-title">things i've made
      <svg class="boil" width="54" height="40" viewBox="0 0 54 40" aria-hidden="true"><path d="M4 8 C18 6 34 14 42 32 M32 30 L42 33 L45 22" fill="none" stroke="#3d1a22" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </h2>
    <div class="list">
      {projects.map((p, i) => (
        <a class="row" href={p.href ?? '/projects'}>
          <em class="num" style={`--c:var(--${p.color})`}>0{i + 1}</em>
          <b>{p.name}</b>
          <span class="chip">{p.tags.slice(0, 2).join(' · ')}</span>
          <i>→</i>
        </a>
      ))}
    </div>

    <!-- CREDENTIALS TEASER -->
    <h2 class="section-title">receipts <Doodle name="medal" color="peach" size={36} /></h2>
    <div class="stats">
      <a href="/credentials" class="stat sticker reveal" style="--c:var(--sage)"><Doodle name="chart" color="sage" size={56} /><b>{certCount}</b> certificates</a>
      <a href="/credentials#awards" class="stat sticker reveal" style="--c:var(--butter)"><Doodle name="trophy" color="butter" size={56} /><b>{awards.length}</b> awards</a>
      <a href="/credentials#languages" class="stat sticker reveal" style="--c:var(--lilac)"><Doodle name="speech" color="lilac" size={56} /><b>4</b> languages</a>
    </div>

    <!-- TO THE COZY SIDE -->
    <a href="/cozy" class="cozy" data-wipe>
      <svg class="yarn boil" width="44" height="44" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="#b7aed0" stroke="#3d1a22" stroke-width="3"/><path d="M8 12 C18 18 22 28 18 36 M14 6 C26 14 30 24 30 32 M6 24 C14 22 26 26 34 22" fill="none" stroke="#3d1a22" stroke-width="2.5"/></svg>
      <span class="label-link">follow the yarn to the cozy side →</span>
    </a>
  </div>
</Base>

<script>
  // big cat: bubble on hover, squish + new word on boop
  const big = document.getElementById('bigcat')!;
  const bub = big.querySelector('.bubble')!;
  const words = ['mrrp!', 'mew!', 'prrt?', 'purrrr', 'boop!'];
  big.addEventListener('mouseenter', () => bub.classList.add('show'));
  big.addEventListener('mouseleave', () => bub.classList.remove('show'));
  big.addEventListener('click', () => {
    big.classList.add('squish');
    bub.textContent = words[Math.floor(Math.random() * words.length)];
    bub.classList.add('show');
    setTimeout(() => big.classList.remove('squish'), 150);
  });

  // split the big name into letters that bounce on hover
  document.querySelectorAll('.split').forEach((h) => {
    h.innerHTML = h.innerHTML.split(/(<br[^>]*>)/).map((part) =>
      /^<br/.test(part) ? part : [...part].map((ch) => `<span class="ch">${ch}</span>`).join('')
    ).join('');
  });
</script>

<style>
  /* hero */
  .hero { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 30px; margin-top: 40px; }
  h1 {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(64px, 12vw, 170px);
    line-height: .85; letter-spacing: -2px; text-transform: uppercase; text-shadow: 6px 6px 0 var(--paper);
  }
  h1 :global(.ch) { display: inline-block; transition: transform .35s cubic-bezier(.3,2,.5,1); }
  h1 :global(.ch:hover) { transform: translateY(-14px) rotate(-8deg) scale(1.08); }
  .sub { font-size: 30px; font-weight: 700; margin-top: 18px; }
  .sub em { font-style: normal; background: var(--cream); padding: 0 10px; border-radius: 8px; display: inline-block; transform: rotate(-2deg); }

  .catbox { position: relative; cursor: pointer; user-select: none; }
  .catbox :global(.cat) { display: block; transition: transform .15s; }
  .catbox.squish :global(.cat) { transform: scale(1.15, .82) translateY(16px); }
  .catbox .hint { text-align: center; font-size: 21px; }
  .catbox .bubble { left: -20px; top: -10px; }
  .catbox :global(.spark) { position: absolute; z-index: 1; animation: twinkle 2.4s ease-in-out infinite; }
  .catbox :global(.s1) { top: 10px; right: -14px; }
  .catbox :global(.s2) { bottom: 80px; left: -34px; animation-delay: .8s; }
  .catbox :global(.s3) { bottom: 44px; right: -6px; animation-delay: 1.6s; }
  @keyframes twinkle { 0%, 100% { transform: scale(1) rotate(0); } 50% { transform: scale(.6) rotate(25deg); } }

  /* about */
  .about { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; margin-top: 40px; }
  .bio-card { position: relative; padding: 30px 32px; max-width: 700px; box-shadow: 7px 7px 0 var(--ink); }
  .bio-card.in { transform: rotate(-1deg); }
  .bio { font-size: 25px; line-height: 1.5; margin-top: 6px; }
  .facts { display: flex; flex-direction: column; gap: 18px; }
  .fact {
    display: flex; align-items: center; gap: 12px; background: var(--c); border: 3px solid var(--ink); border-radius: 999px;
    box-shadow: 4px 4px 0 var(--ink); padding: 6px 20px 6px 8px; font-family: var(--font-display); font-weight: 600; font-size: 19px;
    transition: transform .3s cubic-bezier(.3,1.8,.5,1);
  }
  .fact :global(.doodle) { background: var(--paper); border: 2.5px solid var(--ink); border-radius: 50%; padding: 3px; }
  .fact:nth-child(1) { transform: rotate(2deg); }
  .fact:nth-child(2) { transform: rotate(-2deg) translateX(18px); }
  .fact:nth-child(3) { transform: rotate(1.5deg); }
  .fact:hover { transform: rotate(0) scale(1.06); }

  /* band */
  .band {
    width: 112vw; margin: 80px 0 0 calc(50% - 56vw); background: var(--ink); color: var(--pink-soft); transform: rotate(-2deg);
    padding: 14px 0; overflow: hidden; font-family: var(--font-display); font-weight: 600; font-size: 22px; white-space: nowrap;
  }
  .band .track { display: inline-block; animation: slide 34s linear infinite; }
  .band b { color: var(--butter); font-weight: 600; margin: 0 18px; }
  @keyframes slide { to { transform: translateX(-50%); } }

  /* journey teaser */
  .journey-teaser { display: block; padding: 30px 24px 26px; text-align: center; transition: transform .3s cubic-bezier(.3,1.6,.5,1); }
  .journey-teaser:hover { transform: rotate(-.5deg) translateY(-4px); }
  .trail {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; position: relative; margin-bottom: 22px;
  }
  .trail::before {
    content: ''; position: absolute; left: 10%; right: 10%; top: 35px; border-top: 4px dashed var(--ink); opacity: .35;
  }
  .stop { position: relative; display: flex; flex-direction: column; align-items: center; }
  .stop :global(.doodle) { background: var(--paper); border-radius: 50%; transition: transform .35s cubic-bezier(.3,1.8,.5,1); }
  .journey-teaser:hover .stop:nth-child(odd) :global(.doodle) { transform: translateY(-8px) rotate(-6deg); }
  .journey-teaser:hover .stop:nth-child(even) :global(.doodle) { transform: translateY(-8px) rotate(6deg); }
  .ch-num { font-family: var(--font-display); font-weight: 600; font-size: 14px; opacity: .7; margin-top: 4px; }
  .ch-title { font-size: 19px; font-weight: 700; line-height: 1.2; }

  /* project rows */
  .list { border-top: 3px solid var(--ink); }
  .row {
    display: grid; grid-template-columns: auto 1fr auto auto; gap: 20px; align-items: center; padding: 18px 12px;
    border-bottom: 3px solid var(--ink); position: relative; overflow: hidden;
  }
  .row::before { content: ''; position: absolute; inset: 0; background: var(--ink); transform: translateY(101%); transition: transform .35s cubic-bezier(.7,0,.2,1); }
  .row:hover::before { transform: translateY(0); }
  .row > * { position: relative; transition: color .25s; }
  .row:hover > * { color: var(--pink-soft); }
  .row b { font-family: var(--font-display); font-size: clamp(26px, 4vw, 40px); font-weight: 600; }
  .row i { font-style: normal; font-family: var(--font-display); font-size: 30px; transition: transform .3s; }
  .row:hover i { transform: translateX(8px) rotate(-10deg); }
  .num {
    font-style: normal; font-family: var(--font-display); font-weight: 600; font-size: 18px; width: 50px; height: 50px; border-radius: 50%;
    display: grid; place-items: center; background: var(--c); border: 3px solid var(--ink); color: var(--ink) !important;
    transition: transform .35s cubic-bezier(.3,1.8,.5,1);
  }
  .row:hover .num { transform: rotate(-12deg) scale(1.1); }

  /* stats */
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .stat {
    display: flex; align-items: center; gap: 14px; padding: 18px 20px; background: var(--c);
    font-family: var(--font-display); font-weight: 600; font-size: 20px;
  }
  .stat b { font-size: 42px; line-height: 1; }
  .stat.in:nth-child(1) { transform: rotate(-1.5deg); }
  .stat.in:nth-child(2) { transform: rotate(1deg); }
  .stat.in:nth-child(3) { transform: rotate(-1deg); }
  .stat:hover { transform: rotate(0) translateY(-5px) !important; }

  /* cozy link */
  .cozy { display: inline-flex; align-items: center; gap: 10px; margin-top: 60px; font-size: 25px; font-weight: 700; }
  .cozy .yarn { animation: roll 3s ease-in-out infinite; }
  .cozy:hover .label-link { text-decoration: underline wavy; }
  @keyframes roll { 0%, 100% { transform: translateX(0) rotate(0); } 50% { transform: translateX(10px) rotate(180deg); } }

  @media (max-width: 760px) {
    .hero, .about { grid-template-columns: 1fr; }
    .catbox { justify-self: center; }
    .facts { align-items: flex-start; }
    .trail { grid-template-columns: repeat(3, 1fr); row-gap: 18px; }
    .trail::before { display: none; }
    .row { grid-template-columns: auto 1fr auto; }
    .row .chip { display: none; }
    .stats { grid-template-columns: 1fr; }
  }
</style>
