---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import Logos from '../components/Logos.astro';
import LogoBadge from '../components/LogoBadge.astro';
import Lightbox from '../components/Lightbox.astro';
import { certGroups, awards, languages } from '../data/credentials';

---
<Base title="Credentials" description="Audrey's certificates, awards, and languages.">
  <div class="wrap">
    <h1 class="page-title">Receipts</h1>
    <p class="page-intro">The certificates, awards, and other proof that I did, in fact, do the things. Click a sticker to verify it.</p>

    <!-- AWARDS -->
    <h2 class="section-title" id="awards">awards <Doodle name="trophy" color="butter" size={40} /></h2>
    <div class="awards">
      {awards.map((a) => (
        <div class="award sticker reveal">
          <div class="ribbon"><LogoBadge logo={a.logos?.[0]} doodle={a.place === 'Finalist' ? 'medal' : 'trophy'} color="butter" size={84} /></div>
          <span class="place">{a.place}</span>
          <h3>{a.event}</h3>
          <p class="issuer">{a.issuer}<span class="sep">•</span>{a.date}</p>
          <p class="note">{a.note}</p>
          {(a.cert || a.post) && (
            <p class="proof">
              {a.cert && <button type="button" class="mini" data-zoom={a.cert} aria-label={`See the certificate: ${a.event}`}>see certificate</button>}
              {a.post && <a class="mini" href={a.post} target="_blank" rel="noopener">see the post ↗</a>}
            </p>
          )}
        </div>
      ))}
    </div>

    <!-- CERTIFICATES -->
    {certGroups.map((g) => (
      <section>
        <h2 class="section-title">{g.title.toLowerCase()} certificates <Doodle name={g.doodle} color={g.color} size={40} /></h2>
        <div class="wall">
          {g.certs.map((c) => {
            const Tag = c.url ? 'a' : c.image ? 'button' : 'div';
            return (
              <Tag href={c.url} target={c.url ? '_blank' : undefined} rel={c.url ? 'noopener' : undefined}
                   type={!c.url && c.image ? 'button' : undefined} data-zoom={!c.url ? c.image : undefined}
                   class={`cert reveal ${c.url || c.image ? 'linked' : ''}`} style={`--c:var(--${g.color})`}>
                <Logos keys={c.logos} height={44} class="cert-logos" />
                <span class="issuer-tag">{c.issuer.split(' · ').map((part, i) => <>{i > 0 && <span class="sep">•</span>}{part}</>)}</span>
                <h3>{c.name}</h3>
                <span class="date">{c.date}{c.url ? <><span class="sep">•</span>verify ↗</> : c.image && <><span class="sep">•</span>see certificate</>}</span>
              </Tag>
            );
          })}
        </div>
      </section>
    ))}

    <!-- LANGUAGES -->
    <h2 class="section-title" id="languages">languages in my life <Doodle name="speech" color="lilac" size={40} /></h2>
    <div class="langs">
      {languages.map((l) => (
        <div class="lang reveal" style={`--c:var(--${l.color})`}>
          <b>{l.name}</b>
          <span>{l.note}</span>
        </div>
      ))}
    </div>
  </div>
  <Lightbox />
</Base>

<style>
  .awards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; }
  .award { position: relative; padding: 66px 24px 28px; text-align: center; margin-top: 50px; }
  .award.in:nth-child(odd) { transform: rotate(-1.5deg); }
  .award.in:nth-child(even) { transform: rotate(1.5deg); }
  .ribbon {
    position: absolute; top: -50px; left: 50%; margin-left: -50px; width: 100px; height: 100px; border-radius: 50%;
    background: var(--butter); border: 3px solid var(--ink); display: grid; place-items: center; box-shadow: 3px 3px 0 var(--ink);
  }
  .place {
    display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 15px; text-transform: uppercase;
    letter-spacing: 1px; background: var(--butter); border: 2.5px solid var(--ink); border-radius: 999px; padding: 0 12px;
  }
  .award h3 { font-family: var(--font-display); font-size: 21px; line-height: 1.2; margin-top: 16px; }
  /* who gave it + when: a small label, so it doesn't blend into the description */
  .issuer {
    margin-top: 12px; font-family: var(--font-display); font-weight: 600; font-size: 13.5px; line-height: 1.45;
    text-transform: uppercase; letter-spacing: .8px; opacity: .7;
  }
  .note { font-size: 17px; line-height: 1.45; margin-top: 16px; padding-top: 16px; border-top: 2px dashed rgba(61, 26, 34, .25); }

  .proof { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 16px; }
  .mini {
    font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--ink); background: var(--paper);
    border: 2.5px solid var(--ink); border-radius: 999px; padding: 4px 14px; box-shadow: 2px 2px 0 var(--ink); cursor: pointer;
    transition: transform .2s;
  }
  .mini:hover { transform: translateY(-2px) rotate(-2deg); }

  /* certificate stickers */
  .wall { display: flex; flex-wrap: wrap; gap: 20px; }
  .cert {
    position: relative; flex: 1 1 260px; max-width: 360px; background: var(--c); border: 3px solid var(--ink);
    text-align: left; font: inherit; color: inherit; cursor: auto;
    border-radius: 18px 18px 18px 4px; box-shadow: 5px 5px 0 var(--ink); padding: 20px 20px 18px;
    transition: transform .3s cubic-bezier(.3,1.8,.5,1), box-shadow .2s;
  }
  .cert.in:nth-child(3n+1) { transform: rotate(-1.5deg); }
  .cert.in:nth-child(3n+2) { transform: rotate(1deg); }
  .cert.in:nth-child(3n) { transform: rotate(-.5deg); }
  .cert.linked { cursor: pointer; }
  .cert.linked:hover { transform: rotate(0) translateY(-6px) scale(1.02); box-shadow: 7px 9px 0 var(--ink); }
  /* folded corner */
  .cert::after {
    content: ''; position: absolute; right: -3px; bottom: -3px; width: 26px; height: 26px;
    background: linear-gradient(135deg, var(--paper) 50%, var(--pink) 50%); border-left: 3px solid var(--ink); border-top: 3px solid var(--ink);
    border-radius: 6px 0 0 0;
  }
  .cert :global(.cert-logos) { margin-bottom: 16px; }
  .issuer-tag { display: block; font-family: var(--font-display); font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; opacity: .75; }
  .cert h3 { font-family: var(--font-display); font-size: 19px; line-height: 1.25; margin: 10px 0 10px; padding-right: 10px; }
  .date { font-size: 17px; }


  .langs { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 26px; }
  .lang {
    position: relative; background: var(--c); border: 3px solid var(--ink); border-radius: 22px; padding: 16px 22px 18px;
    box-shadow: 4px 4px 0 var(--ink); display: flex; flex-direction: column;
  }
  .lang::after {
    content: ''; position: absolute; left: 26px; bottom: -14px; width: 20px; height: 20px; background: var(--c);
    border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink); transform: rotate(45deg) skew(10deg, 10deg);
  }
  .lang b { font-family: var(--font-display); font-size: 26px; line-height: 1.1; }
  .lang span { font-size: 18px; line-height: 1.4; margin-top: 6px; }
  .lang.in:nth-child(odd) { transform: rotate(-2deg); }
  .lang.in:nth-child(even) { transform: rotate(2deg); }
</style>
