---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import { site } from '../data/site';
import { certGroups, awards, languages } from '../data/credentials';

const orcid = site.links.find((l) => l.label === 'ORCID');
---
<Base title="Credentials" description="Audrey's certificates, awards, research, and languages.">
  <div class="wrap">
    <h1 class="page-title">Receipts</h1>
    <p class="page-intro">The certificates, awards, and other proof that I did, in fact, do the things. Click a sticker to verify it.</p>

    <!-- AWARDS -->
    <h2 class="section-title" id="awards">awards <Doodle name="trophy" color="butter" size={40} /></h2>
    <div class="awards">
      {awards.map((a) => (
        <div class="award sticker reveal">
          <div class="ribbon"><Doodle name={a.place === 'Finalist' ? 'medal' : 'trophy'} color={a.place === 'Champion' ? 'butter' : 'peach'} size={64} /></div>
          <span class="place">{a.place}</span>
          <h3>{a.event}</h3>
          <p class="issuer">{a.issuer} · {a.date}</p>
          <p class="note">{a.note}</p>
        </div>
      ))}
    </div>

    <!-- CERTIFICATES -->
    {certGroups.map((g) => (
      <section>
        <h2 class="section-title">{g.title.toLowerCase()} certificates <Doodle name={g.doodle} color={g.color} size={40} /></h2>
        <div class="wall">
          {g.certs.map((c) => {
            const Tag = c.url ? 'a' : 'div';
            return (
              <Tag href={c.url} target={c.url ? '_blank' : undefined} rel={c.url ? 'noopener' : undefined}
                   class={`cert reveal ${c.url ? 'linked' : ''}`} style={`--c:var(--${g.color})`}>
                <span class="issuer-tag">{c.issuer}</span>
                <h3>{c.name}</h3>
                <span class="date">{c.date}{c.url && <> · verify ↗</>}</span>
              </Tag>
            );
          })}
        </div>
      </section>
    ))}

    <!-- RESEARCH -->
    <h2 class="section-title">research <Doodle name="book" color="sky" size={40} /></h2>
    <div class="sticker research reveal">
      <span class="tape" style="--c:var(--sky)"></span>
      <p>[Your undergraduate thesis title and a one-line summary go here. It won the MCITS 2023 paper presentation and was an OSRA 2023 finalist.]</p>
      {orcid && <a class="btn" style="--c:var(--sky)" href={orcid.url} target="_blank" rel="noopener">my ORCID profile ↗</a>}
    </div>

    <!-- LANGUAGES -->
    <h2 class="section-title" id="languages">languages i speak <Doodle name="speech" color="lilac" size={40} /></h2>
    <div class="langs">
      {languages.map((l) => (
        <div class="lang reveal" style={`--c:var(--${l.color})`}>
          <b>{l.name}</b>
          <span>{l.note}</span>
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .awards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; }
  .award { position: relative; padding: 50px 20px 22px; text-align: center; margin-top: 30px; }
  .award.in:nth-child(odd) { transform: rotate(-1.5deg); }
  .award.in:nth-child(even) { transform: rotate(1.5deg); }
  .ribbon {
    position: absolute; top: -40px; left: 50%; margin-left: -42px; width: 84px; height: 84px; border-radius: 50%;
    background: var(--paper); border: 3px solid var(--ink); display: grid; place-items: center;
  }
  .place {
    display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: 15px; text-transform: uppercase;
    letter-spacing: 1px; background: var(--butter); border: 2.5px solid var(--ink); border-radius: 999px; padding: 0 12px;
  }
  .award h3 { font-family: var(--font-display); font-size: 21px; line-height: 1.2; margin-top: 8px; }
  .issuer { font-size: 17px; opacity: .8; }
  .note { font-size: 17px; line-height: 1.4; margin-top: 8px; }

  /* certificate stickers */
  .wall { display: flex; flex-wrap: wrap; gap: 20px; }
  .cert {
    position: relative; flex: 1 1 260px; max-width: 360px; background: var(--c); border: 3px solid var(--ink);
    border-radius: 18px 18px 18px 4px; box-shadow: 5px 5px 0 var(--ink); padding: 18px 18px 14px;
    transition: transform .3s cubic-bezier(.3,1.8,.5,1), box-shadow .2s;
  }
  .cert.in:nth-child(3n+1) { transform: rotate(-1.5deg); }
  .cert.in:nth-child(3n+2) { transform: rotate(1deg); }
  .cert.in:nth-child(3n) { transform: rotate(-.5deg); }
  .cert.linked:hover { transform: rotate(0) translateY(-6px) scale(1.02); box-shadow: 7px 9px 0 var(--ink); }
  /* folded corner */
  .cert::after {
    content: ''; position: absolute; right: -3px; bottom: -3px; width: 26px; height: 26px;
    background: linear-gradient(135deg, var(--paper) 50%, var(--pink) 50%); border-left: 3px solid var(--ink); border-top: 3px solid var(--ink);
    border-radius: 6px 0 0 0;
  }
  .issuer-tag { font-family: var(--font-display); font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; opacity: .75; }
  .cert h3 { font-family: var(--font-display); font-size: 19px; line-height: 1.25; margin: 2px 0 6px; padding-right: 10px; }
  .date { font-size: 17px; }

  .research { position: relative; padding: 32px 30px 26px; font-size: 21px; max-width: 760px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }

  .langs { display: flex; flex-wrap: wrap; gap: 22px; }
  .lang {
    position: relative; background: var(--c); border: 3px solid var(--ink); border-radius: 22px; padding: 14px 24px;
    box-shadow: 4px 4px 0 var(--ink); display: flex; flex-direction: column;
  }
  .lang::after {
    content: ''; position: absolute; left: 26px; bottom: -14px; width: 20px; height: 20px; background: var(--c);
    border-right: 3px solid var(--ink); border-bottom: 3px solid var(--ink); transform: rotate(45deg) skew(10deg, 10deg);
  }
  .lang b { font-family: var(--font-display); font-size: 26px; line-height: 1.1; }
  .lang span { font-size: 18px; }
  .lang.in:nth-child(odd) { transform: rotate(-2deg); }
  .lang.in:nth-child(even) { transform: rotate(2deg); }
</style>
