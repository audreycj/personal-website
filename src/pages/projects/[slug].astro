---
// ==========================================================
// CASE STUDY PAGE: one page per entry in caseStudies (src/data/projects.ts)
// The URL is /projects/<slug>.
// ==========================================================
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';
import Shot from '../../components/Shot.astro';
import Lightbox from '../../components/Lightbox.astro';
import { caseStudies, type CaseStudy } from '../../data/projects';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props as { cs: CaseStudy };
const group = caseStudies.filter((c) => c.category === cs.category);
const next = group[(group.findIndex((c) => c.slug === cs.slug) + 1) % group.length];
// the cover shows on top; the rest go in the gallery (phone screens get their own row)
const coverShot = cs.shots.find((s) => s.src === cs.cover) ?? { src: cs.cover, caption: '', device: 'browser' as const };
const gallery = cs.shots.filter((s) => s.src !== cs.cover);
const phones = gallery.filter((s) => s.device === 'phone');
const others = gallery.filter((s) => s.device !== 'phone');
const sectionLabel = cs.category === 'design' ? 'UI/UX design' : 'data analytics';
---
<Base title={cs.name} description={cs.tagline}>
  <div class="wrap">
    <a href={`/projects#${cs.category}`} class="back">← all projects</a>
    <span class="label kicker">{sectionLabel}</span>

    <section class="hero">
      <div>
        <h1 class="title">{cs.name}</h1>
        <p class="tagline">{cs.tagline}</p>
        <p class="tags">{cs.tags.map((t) => <span class="chip">{t}</span>)}</p>
        {cs.links && (
          <p class="links">
            {cs.links.map((l) => <a class="btn" style={`--c:var(--${cs.color})`} href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
          </p>
        )}
      </div>
      <dl class="facts sticker reveal" style={`--c:var(--${cs.color})`}>
        <span class="tape" style={`--c:var(--${cs.color})`}></span>
        {cs.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </section>

    <div class="cover reveal">
      <Shot {...coverShot} />
    </div>

    <!-- THE BRIEF + MY PART -->
    <section class="two">
      <div class="note sticker reveal">
        <span class="tape" style="--c:var(--peach)"></span>
        <h2><Doodle name="sparkle" color="peach" size={30} /> the brief</h2>
        {cs.problem.map((p) => <p>{p}</p>)}
      </div>
      <div class="note sticker reveal">
        <span class="tape" style={`--c:var(--${cs.color})`}></span>
        <h2><Doodle name="notebook" color={cs.color} size={30} /> what I did</h2>
        {cs.role.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <!-- FEATURES -->
    {cs.features && <>
      <h2 class="section-title">what's inside</h2>
      <div class="features">
        {cs.features.map((f, i) => (
          <div class="feature sticker reveal" style={`--c:var(--${['sage', 'butter', 'lilac', 'peach'][i % 4]})`}>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </>}

    <!-- SCREENS -->
    {gallery.length > 0 && <>
      <h2 class="section-title">{cs.category === 'design' ? 'the screens' : 'the work'} <span class="hint">(tap to zoom)</span></h2>
      {others.length > 0 && <div class="shots">{others.map((s) => <div class="reveal"><Shot {...s} /></div>)}</div>}
      {phones.length > 0 && <div class="phones">{phones.map((s) => <div class="reveal"><Shot {...s} /></div>)}</div>}
    </>}

    <!-- PROCESS -->
    {cs.process && <>
      <h2 class="section-title">how it went</h2>
      <ol class="process">
        {cs.process.map((p, i) => (
          <li class="step sticker reveal">
            <span class="num" style={`--c:var(--${cs.color})`}>{i + 1}</span>
            <h3>{p.step}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </>}

    {cs.takeaway && <p class="takeaway reveal">{cs.takeaway}</p>}

    {next && next.slug !== cs.slug && (
      <a class="next sticker reveal" href={`/projects/${next.slug}`} style={`--c:var(--${next.color})`}>
        <span class="label">next {sectionLabel} project</span>
        <b>{next.name} →</b>
      </a>
    )}
  </div>
  <Lightbox />
</Base>

<style>
  .back { display: inline-block; margin-top: 48px; font-size: 20px; font-weight: 700; text-decoration: underline wavy; text-underline-offset: 5px; }
  .kicker { display: block; margin-top: 22px; }

  .hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; align-items: start; margin-top: 8px; }
  .title { font-family: var(--font-display); font-weight: 700; font-size: clamp(36px, 5.5vw, 62px); line-height: 1.02; text-shadow: 4px 4px 0 var(--paper); }
  .tagline { font-size: 24px; line-height: 1.45; margin-top: 16px; max-width: 640px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .tags .chip { font-size: 16px; background: var(--paper); }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }

  .facts { position: relative; padding: 30px 26px 22px; margin-top: 14px; display: grid; gap: 14px; }
  .facts.in { transform: rotate(1.5deg); }
  .facts dt { font-family: var(--font-display); font-weight: 600; font-size: 13.5px; text-transform: uppercase; letter-spacing: .8px; opacity: .7; }
  .facts dd { font-size: 20px; line-height: 1.3; }

  .cover { margin-top: 56px; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; margin-top: 70px; }
  .note { position: relative; padding: 32px 30px 26px; }
  .note.in:nth-child(1) { transform: rotate(-1deg); }
  .note.in:nth-child(2) { transform: rotate(1deg); }
  .note h2 { display: flex; align-items: center; gap: 8px; font-family: var(--font-display); font-size: 26px; }
  .note p { font-size: 20px; line-height: 1.55; margin-top: 12px; }

  .hint { font-size: 18px; font-weight: 400; opacity: .6; }

  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 24px; }
  .feature { padding: 22px; background: var(--c); }
  .feature h3 { font-family: var(--font-display); font-size: 21px; }
  .feature p { font-size: 18px; line-height: 1.45; margin-top: 6px; }
  .feature.in:nth-child(odd) { transform: rotate(-1deg); }
  .feature.in:nth-child(even) { transform: rotate(1deg); }

  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 44px 36px; }
  .phones { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px; margin-top: 10px; }

  .process { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; }
  .step { position: relative; padding: 32px 20px 20px; }
  .step .num {
    position: absolute; top: -18px; left: 20px; width: 38px; height: 38px; border-radius: 50%; background: var(--c);
    border: 3px solid var(--ink); display: grid; place-items: center; font-family: var(--font-display); font-weight: 700;
  }
  .step h3 { font-family: var(--font-display); font-size: 20px; }
  .step p { font-size: 18px; line-height: 1.45; margin-top: 6px; }

  .takeaway { font-size: 22px; margin-top: 50px; max-width: 760px; }

  .next {
    display: flex; flex-direction: column; gap: 4px; margin-top: 80px; padding: 22px 26px; background: var(--c);
    transition: transform .3s cubic-bezier(.3,1.6,.5,1);
  }
  .next b { font-family: var(--font-display); font-size: 24px; }
  .next:hover { transform: translateY(-4px) rotate(-.5deg); }

  @media (max-width: 860px) {
    .hero, .two { grid-template-columns: 1fr; }
    .shots { grid-template-columns: 1fr; }
  }
</style>
