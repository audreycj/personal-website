---
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';
import { projects } from '../../data/projects';
---
<Base title="Projects" description="Things Audrey has designed and built.">
  <div class="wrap">
    <h1 class="page-title">Things<br />I've Made</h1>
    <p class="page-intro">Some for work, some for school, and some just because something annoyed me enough to fix it.</p>

    <div class="grid">
      {projects.map((p, i) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <Tag href={p.href} class={`card sticker reveal ${p.href ? 'live' : 'soon'}`} style={`--c:var(--${p.color})`}>
            <div class="thumb">
              <Doodle name={p.doodle} color={p.color} size={110} />
              {!p.href && <span class="stamp">coming soon</span>}
            </div>
            <div class="body">
              <span class="label">project 0{i + 1}</span>
              <h2>{p.name}</h2>
              <p>{p.blurb}</p>
              <p class="tags">{p.tags.map((t) => <span class="chip">{t}</span>)}</p>
              {p.href && <span class="btn" style={`--c:var(--${p.color})`}>read the story →</span>}
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 34px; margin-top: 60px; }
  .card { overflow: hidden; display: flex; flex-direction: column; transition: transform .35s cubic-bezier(.3,1.6,.5,1); }
  .card.in:nth-child(1) { transform: rotate(-1.5deg); }
  .card.in:nth-child(2) { transform: rotate(1.5deg); }
  .card.in:nth-child(3) { transform: rotate(-1deg); }
  .card.live:hover { transform: rotate(0) translateY(-8px); }
  .thumb {
    position: relative; height: 180px; display: grid; place-items: center; border-bottom: 3px solid var(--ink);
    background: var(--c) radial-gradient(rgba(255,255,255,.45) 2px, transparent 2px) 0 0 / 18px 18px;
  }
  .thumb :global(.doodle) { transition: transform .4s cubic-bezier(.3,1.8,.5,1); }
  .card.live:hover .thumb :global(.doodle) { transform: rotate(-8deg) scale(1.12); }
  .stamp {
    position: absolute; right: 16px; top: 16px; transform: rotate(10deg); border: 3px solid var(--ink); border-radius: 8px;
    padding: 0 10px; font-family: var(--font-display); font-weight: 700; font-size: 15px; text-transform: uppercase;
    background: var(--paper);
  }
  .body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .body h2 { font-family: var(--font-display); font-size: 30px; line-height: 1.1; }
  .body p { font-size: 20px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags .chip { font-size: 15px; }
  .btn { align-self: flex-start; margin-top: 10px; }
</style>
