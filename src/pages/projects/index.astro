---
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';
import Lightbox from '../../components/Lightbox.astro';
import { caseStudies, practice } from '../../data/projects';

const design = caseStudies.filter((c) => c.category === 'design');
const data = caseStudies.filter((c) => c.category === 'data');
const tilt = ['-1.5deg', '1.2deg', '-1deg', '1.5deg'];
---
<Base title="Projects" description="Things Audrey has designed and built: a Discord bot, a lessons website for her students, a study notebook, UI/UX design for real clients, and data analytics work.">
  <div class="wrap">
    <h1 class="page-title">Things<br />I've Made</h1>
    <p class="page-intro">
      Some for work, some for school, and some just because something annoyed me enough to fix it.
    </p>

    <nav class="jump" aria-label="Project sections">
      <a href="#built" style="--c:var(--sage)">things i built</a>
      <a href="#design" style="--c:var(--lilac)">UI/UX design</a>
      <a href="#data" style="--c:var(--peach)">data analytics</a>
    </nav>

    <!-- BUILT -->
    <h2 class="section-title" id="built">things i built <Doodle name="laptop" color="sage" size={36} /></h2>
    <a href="/projects/mingming" class="feature-card sticker reveal" style="--c:var(--sage)">
      <div class="feature-art photo"><img src="/projects/mingming/welcome-panel.webp" alt="Mingming's welcome panel in Discord" loading="lazy" decoding="async" /></div>
      <div class="feature-body">
        <span class="label">personal project · 2026</span>
        <h3>Mingming bot</h3>
        <p>A Discord bot that registers students in my class servers with their proper names, checks them against the class list, and unlocks their section's channels.</p>
        <p class="tags"><span class="chip">Discord</span><span class="chip">Cloudflare Workers</span><span class="chip">JavaScript</span></p>
        <span class="btn" style="--c:var(--sage)">read the story →</span>
      </div>
    </a>

    <a href="https://audreycj-lessons.audreycj.workers.dev/" id="lessons" class="feature-card sticker reveal" style="--c:var(--sky)" target="_blank" rel="noopener">
      <div class="feature-art photo"><img src="/projects/lessons/itc120.webp" alt="The ITC 120 Data Structures and Algorithms page of my lessons website, with prelim and midterm topics" loading="lazy" decoding="async" /></div>
      <div class="feature-body">
        <span class="label">for my students · 2026</span>
        <h3>Ma'am Audrey's lessons</h3>
        <p>A website that holds the lessons for the courses I teach. Lately we've had a lot of no-class days, and making a PDF module from scratch each time was tedious. PDFs are also basically permanent, so I couldn't add anything I thought of later. Now each lesson is in plain English, with pictures students can tap and play with, paper practice, and self-checks, and I can keep improving it for current and future students.</p>
        <p class="tags"><span class="chip">Astro</span><span class="chip">Cloudflare Workers</span><span class="chip">interactive visuals</span></p>
        <span class="btn" style="--c:var(--sky)">open the lessons ↗</span>
      </div>
    </a>

    <a href="https://audreycj-notebook.audreycj.workers.dev/" id="notebook" class="feature-card sticker reveal" style="--c:var(--butter)" target="_blank" rel="noopener">
      <div class="feature-art photo"><img src="/projects/notebook/shelf.webp" alt="The home page of my MIT study notebook, showing the MIT-O615 course on the shelf" loading="lazy" decoding="async" /></div>
      <div class="feature-body">
        <span class="label">personal project · 2026</span>
        <h3>MIT study notebook</h3>
        <p>My Master's in IT lessons, rewritten in plain English with interactive diagrams, step-by-step walkthroughs, quizzes, and doodles. The lecture slides were too technical to stick, and drawing things out is how I actually learn, so I made the notebook I wished I had.</p>
        <p class="tags"><span class="chip">Astro</span><span class="chip">Cloudflare Workers</span><span class="chip">interactive visuals</span></p>
        <span class="btn" style="--c:var(--butter)">open the notebook ↗</span>
      </div>
    </a>

    <!-- DESIGN -->
    <h2 class="section-title" id="design">UI/UX design <Doodle name="phone" color="lilac" size={36} /></h2>
    <p class="section-intro">Web and mobile apps I designed for real clients at Telemondo Technologies, from the first wireframe to the user manual.</p>
    <div class="cards">
      {design.map((c, i) => (
        <a href={`/projects/${c.slug}`} class="card sticker reveal" style={`--c:var(--${c.color}); --tilt:${tilt[i % 4]}`}>
          <div class="thumb"><img src={c.cover} alt={`${c.name} preview`} loading="lazy" decoding="async" /></div>
          <div class="body">
            <span class="label">{c.facts.find((f) => f.label === 'year')?.value}<span class="sep">•</span>{c.facts.find((f) => f.label === 'my role')?.value}</span>
            <h3>{c.name}</h3>
            <p>{c.tagline}</p>
            <span class="more">see the case study →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- DATA -->
    <h2 class="section-title" id="data">data analytics <Doodle name="chart" color="peach" size={36} /></h2>
    <p class="section-intro">My bootcamp capstone, plus the practice projects I built while learning SQL, Power BI, and Looker Studio.</p>
    {data.map((c) => (
      <a href={`/projects/${c.slug}`} class="feature-card sticker reveal" style={`--c:var(--${c.color})`}>
        <div class="feature-art photo"><img src={c.cover} alt={`${c.name} preview`} loading="lazy" decoding="async" /></div>
        <div class="feature-body">
          <span class="label">capstone<span class="sep">•</span>{c.facts.find((f) => f.label === 'year')?.value}</span>
          <h3>{c.name}</h3>
          <p>{c.tagline}</p>
          <p class="tags">{c.tags.map((t) => <span class="chip">{t}</span>)}</p>
          <span class="btn" style={`--c:var(--${c.color})`}>see the case study →</span>
        </div>
      </a>
    ))}

    <h3 class="sub-title">practice projects <span>(guided by online tutorials)</span></h3>
    <div class="practice">
      {practice.map((p, i) => (
        <div class="pin reveal" style={`--c:var(--${p.color}); --tilt:${tilt[(i + 1) % 4]}`}>
          <span class="pin-tape" aria-hidden="true"></span>
          <button type="button" class="pin-photo" data-zoom={p.image} aria-label={`View larger: ${p.name}`}>
            <img src={p.image} alt={`${p.name} screenshot`} loading="lazy" decoding="async" />
          </button>
          <span class="pin-tool">{p.tool}</span>
          <h4>{p.name}</h4>
          <p>{p.note}</p>
          {p.link && <a href={p.link.url} target="_blank" rel="noopener">{p.link.label} ↗</a>}
        </div>
      ))}
    </div>
  </div>
  <Lightbox />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .jump a {
    font-family: var(--font-display); font-weight: 600; font-size: 17px; padding: 6px 18px; background: var(--c);
    border: 2.5px solid var(--ink); border-radius: 999px; box-shadow: 3px 3px 0 var(--ink); transition: transform .2s;
  }
  .jump a:hover { transform: translateY(-3px) rotate(-2deg); }

  .section-title, .feature-card { scroll-margin-top: 20px; }
  .section-intro { font-size: 21px; max-width: 760px; margin: -4px 0 30px; }

  /* big horizontal card (Mingming, capstone) */
  .feature-card {
    display: grid; grid-template-columns: 300px 1fr; overflow: hidden; margin-bottom: 30px;
    transition: transform .35s cubic-bezier(.3,1.6,.5,1);
  }
  .feature-card.in { transform: rotate(-.6deg); }
  .feature-card:hover { transform: rotate(0) translateY(-6px); }
  .feature-art {
    display: grid; place-items: center; border-right: 3px solid var(--ink); min-height: 230px;
    background: var(--c) radial-gradient(rgba(255,255,255,.45) 2px, transparent 2px) 0 0 / 18px 18px;
  }
  .feature-art.photo { padding: 16px; }
  .feature-art.photo img { width: 100%; height: auto; border: 2.5px solid var(--ink); border-radius: 8px; background: #fff; }
  .feature-body { padding: 26px 28px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .feature-body h3 { font-family: var(--font-display); font-size: 30px; line-height: 1.1; }
  .feature-body p { font-size: 20px; line-height: 1.45; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags .chip { font-size: 15px; }
  .feature-body .btn { margin-top: 8px; }

  /* design cards */
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
  .card { overflow: hidden; display: flex; flex-direction: column; transition: transform .35s cubic-bezier(.3,1.6,.5,1); }
  .card.in { transform: rotate(var(--tilt)); }
  .card:hover { transform: rotate(0) translateY(-8px); }
  .thumb {
    aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 3px solid var(--ink); padding: 18px 18px 0;
    background: var(--c) radial-gradient(rgba(255,255,255,.45) 2px, transparent 2px) 0 0 / 18px 18px;
  }
  .thumb img {
    display: block; width: 100%; height: 100%; object-fit: cover; object-position: top;
    border: 2.5px solid var(--ink); border-bottom: 0; border-radius: 10px 10px 0 0; background: #fff;
    transition: transform .4s cubic-bezier(.3,1.6,.5,1);
  }
  .card:hover .thumb img { transform: translateY(-6px) scale(1.02); }
  .body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .body h3 { font-family: var(--font-display); font-size: 24px; line-height: 1.15; }
  .body p { font-size: 19px; line-height: 1.45; flex: 1; }
  .more { font-weight: 700; font-size: 18px; text-decoration: underline wavy; text-underline-offset: 5px; }

  /* practice pinboard */
  .sub-title { font-family: var(--font-display); font-size: 26px; margin: 60px 0 26px; }
  .sub-title span { font-family: var(--font-hand); font-weight: 400; font-size: 19px; opacity: .7; }
  .practice { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px 30px; }
  .pin {
    position: relative; background: var(--paper); border: 3px solid var(--ink); border-radius: 6px;
    box-shadow: 5px 5px 0 var(--ink); padding: 14px 14px 18px; display: flex; flex-direction: column; gap: 6px;
  }
  .pin.in { transform: rotate(var(--tilt)); }
  .pin-tape {
    position: absolute; top: -14px; left: 50%; width: 90px; height: 26px; margin-left: -45px; transform: rotate(-3deg);
    background: var(--c); opacity: .9; border-left: 3px dashed rgba(255,255,255,.7); border-right: 3px dashed rgba(255,255,255,.7);
  }
  .pin-photo { padding: 0; border: 2px solid var(--ink); border-radius: 4px; overflow: hidden; cursor: zoom-in; background: #fff; }
  .pin-photo img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; transition: transform .3s; }
  .pin-photo:hover img { transform: scale(1.04); }
  .pin-tool { margin-top: 6px; font-family: var(--font-display); font-weight: 600; font-size: 13.5px; text-transform: uppercase; letter-spacing: .8px; opacity: .7; }
  .pin h4 { font-family: var(--font-display); font-size: 20px; line-height: 1.2; }
  .pin p { font-size: 17px; line-height: 1.45; flex: 1; }
  .pin a { font-size: 17px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 760px) {
    .feature-card { grid-template-columns: 1fr; }
    .feature-art { border-right: 0; border-bottom: 3px solid var(--ink); min-height: 180px; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
