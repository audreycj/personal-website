---
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';

const steps = [
  { doodle: 'paw', color: 'peach', title: 'A student joins', text: 'They land in a welcome channel with one big Register button.' },
  { doodle: 'notebook', color: 'butter', title: 'They fill in a form', text: 'First name, middle name, last name, suffix, and email.' },
  { doodle: 'book', color: 'lilac', title: 'MingMing checks the list', text: 'Their name is matched against my official class list.' },
  { doodle: 'sparkle', color: 'sage', title: 'Done!', text: 'Nickname set to "Last, First" and their section role assigned.' },
];

const features = [
  { title: 'Class-list verification', text: 'Sections are assigned from the official class list, not chosen by students.', color: 'sage' },
  { title: 'Typos get flagged, not fixed', text: 'If a name doesn\'t match the list, the student\'s own spelling is kept and I get pinged to review it.', color: 'butter' },
  { title: 'Emails collected', text: 'So I can reach students about grades outside Discord.', color: 'lilac' },
  { title: 'Instructor commands', text: '/unregistered shows who hasn\'t signed up, and /reset-student lets someone redo their registration.', color: 'peach' },
];

const stack = ['JavaScript', 'Cloudflare Workers', 'Cloudflare D1 (SQL)', 'Discord Interactions API'];
---
<Base title="MingMing bot" description="A cat-themed Discord bot Audrey built to register students in her class servers.">
  <div class="wrap">
    <a href="/projects" class="back">← all projects</a>
    <section class="hero">
      <div>
        <span class="label">project 01 · personal project · 2026</span>
        <h1 class="page-title">MingMing</h1>
        <p class="page-intro">A Discord bot that gets students registered with their proper names, so I can actually find them.</p>
        <p class="tags">{stack.map((t) => <span class="chip">{t}</span>)}</p>
      </div>
      <div class="hero-art">
        <Doodle name="bot" color="sage" size={220} />
      </div>
    </section>

    <!-- THE PROBLEM -->
    <h2 class="section-title">the problem <Doodle name="sparkle" color="peach" size={28} /></h2>
    <div class="problem">
      <div class="sticker note reveal">
        <span class="tape" style="--c:var(--peach)"></span>
        <p>
          I use Discord for class communication because I wanted to keep my professional and personal spaces separate
          (Messenger is the default in the Philippines). I asked students to rename themselves with their full names so
          I could find them easily.
        </p>
        <p>
          It turns out I <mark style="--c:var(--peach)">overestimated a group of humans' ability to be uniform</mark>.
          The nicknames were a mess, and looking up a student to message them took forever.
          No existing bot did exactly what I needed, so I thought: <mark style="--c:var(--sage)">why don't I just make one?</mark>
        </p>
      </div>
      <div class="messy reveal" aria-label="Examples of messy nicknames">
        <span class="label">what the member list looked like</span>
        <span class="nick" style="--r:-3deg">xX_jm_Xx</span>
        <span class="nick" style="--r:2deg">ana 2E</span>
        <span class="nick" style="--r:-1deg">BSIT-1A rey</span>
        <span class="nick" style="--r:3deg">🍓kaykay🍓</span>
        <span class="arrow">↓ after MingMing ↓</span>
        <span class="nick clean">Dela Cruz, Juan</span>
        <span class="nick clean">Santos, Ana</span>
      </div>
    </div>

    <!-- HOW IT WORKS -->
    <h2 class="section-title">how it works
      <svg class="boil" width="54" height="40" viewBox="0 0 54 40" aria-hidden="true"><path d="M4 8 C18 6 34 14 42 32 M32 30 L42 33 L45 22" fill="none" stroke="#3d1a22" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </h2>
    <ol class="flow">
      {steps.map((s, i) => (
        <li class="step sticker reveal" style={`--c:var(--${s.color})`}>
          <span class="step-num">{i + 1}</span>
          <Doodle name={s.doodle} color={s.color} size={70} />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="aside">
      Behind the scenes: when a student clicks the button, Discord sends a request to MingMing on Cloudflare. MingMing wakes up,
      does the job, saves the record to a small SQL database, and goes back to sleep. Nothing runs on my laptop, and it costs nothing.
    </p>

    <!-- FEATURES -->
    <h2 class="section-title">features i'm proud of</h2>
    <div class="features">
      {features.map((f) => (
        <div class="feature sticker reveal" style={`--c:var(--${f.color})`}>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>

    <!-- SCREENSHOTS (placeholder) -->
    <h2 class="section-title">screenshots</h2>
    <div class="placeholder sticker">
      <Doodle name="camera" color="sky" size={60} />
      <p>[Add screenshots here: the welcome panel, the form, and the #join-log alert. Blur student names and emails first!]</p>
    </div>

    <!-- WHAT I LEARNED -->
    <h2 class="section-title">what it meant to me</h2>
    <div class="sticker journal-card reveal">
      <span class="tape" style="--c:var(--lilac)"></span>
      <p>
        For a long time I did "tech things" to graduate, then to get a job. MingMing was the first time I asked,
        "what can I make to fix a problem I'm personally facing?" It was a turning point for me.
        Maybe it came late, but late is better than never.
      </p>
    </div>
  </div>
</Base>

<style>
  .back { display: inline-block; margin-top: 30px; font-size: 20px; font-weight: 700; text-decoration: underline wavy; text-underline-offset: 5px; }
  .hero { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: center; margin-top: 20px; }
  .hero-art { animation: float 4s ease-in-out infinite; }
  @keyframes float { 0%, 100% { transform: translateY(0) rotate(-3deg); } 50% { transform: translateY(-10px) rotate(3deg); } }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .tags .chip { font-size: 16px; background: var(--paper); }

  .problem { display: grid; grid-template-columns: 1.4fr 1fr; gap: 34px; align-items: center; }
  .note { position: relative; padding: 30px 30px 24px; font-size: 21px; }
  .note p + p { margin-top: 12px; }
  .note.in { transform: rotate(-1deg); }
  .messy { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .nick {
    font-family: var(--font-display); font-weight: 600; font-size: 19px; background: #fff; border: 2.5px solid var(--ink);
    border-radius: 10px; padding: 4px 14px; transform: rotate(var(--r, 0));
  }
  .nick.clean { background: var(--sage); }
  .arrow { font-weight: 700; font-size: 19px; margin: 4px 0; }

  .flow { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px; position: relative; }
  .step { position: relative; padding: 30px 18px 20px; text-align: center; background: var(--paper); }
  .step:not(:last-child)::after {
    content: '→'; position: absolute; right: -30px; top: 50%; transform: translateY(-50%);
    font-family: var(--font-display); font-size: 28px; font-weight: 700;
  }
  .step.in:nth-child(odd) { transform: rotate(-1.5deg); }
  .step.in:nth-child(even) { transform: rotate(1.5deg); }
  .step-num {
    position: absolute; top: -18px; left: 50%; margin-left: -18px; width: 36px; height: 36px; border-radius: 50%;
    background: var(--c); border: 3px solid var(--ink); display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 700;
  }
  .step h3 { font-family: var(--font-display); font-size: 22px; margin-top: 6px; }
  .step p { font-size: 18px; line-height: 1.4; }
  .aside { font-size: 20px; max-width: 760px; margin-top: 30px; }

  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  .feature { padding: 22px; background: var(--c); }
  .feature h3 { font-family: var(--font-display); font-size: 22px; }
  .feature p { font-size: 19px; line-height: 1.4; margin-top: 4px; }
  .feature.in:nth-child(odd) { transform: rotate(-1deg); }
  .feature.in:nth-child(even) { transform: rotate(1deg); }

  .placeholder { display: flex; align-items: center; gap: 18px; padding: 24px; font-size: 20px; border-style: dashed; box-shadow: none; }
  .journal-card { position: relative; padding: 32px 30px 26px; font-size: 22px; max-width: 760px; }

  @media (max-width: 860px) {
    .hero, .problem { grid-template-columns: 1fr; }
    .hero-art { justify-self: center; }
    .flow { grid-template-columns: 1fr 1fr; }
    .step::after { display: none; }
  }
  @media (max-width: 520px) { .flow { grid-template-columns: 1fr; } }
</style>
