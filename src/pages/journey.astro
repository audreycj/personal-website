---
import Base from '../layouts/Base.astro';
import Cat from '../components/Cat.astro';
import Doodle from '../components/Doodle.astro';
import { chapters, thread } from '../data/journey';

let stopIndex = 0; // used to alternate left/right
---
<Base journal title="Journey" description="Audrey's path so far: school, computer science, UI/UX design, and teaching.">
  <div class="wrap">
    <h1 class="page-title">The<br />Journey</h1>
    <p class="page-intro">
      How a girl who asked her mom to pick her college program ended up teaching IT, and is now building things to solve problems she actually has.
    </p>
    <p class="page-intro intro-2">
      The <a href="/work">work</a>, <a href="/education">education</a>, and <a href="/credentials">credentials</a> tabs list the facts.
      This page puts them all on one road, in order, and tells the story in between: what happened at each stop, and what I took away from it.
    </p>
    <p class="page-intro intro-2">
      Scroll down the path. Each stop has <mark style="--c:var(--lilac)">the full story</mark> behind it if you want more.
    </p>
  </div>

  <div class="wrap">
    <div class="path" id="path">
      <div class="walker" id="walker" aria-hidden="true"><Cat coat="tabby" size={70} /></div>

      {chapters.map((ch) => (
        <section class="chapter">
          <div class="chapter-label reveal">
            <span class="tape" style="--c:var(--butter)"></span>
            <span class="label">chapter {ch.number}</span>
            <h2>{ch.title}</h2>
            <p>{ch.blurb}</p>
          </div>

          {ch.stops.map((s) => {
            const side = stopIndex++ % 2 === 0 ? 'left' : 'right';
            return (
              <article class={`stop ${side}`}>
                <div class="node reveal" style={`--c:var(--${s.color})`}>
                  <Doodle name={s.doodle} color={s.color} size={66} />
                </div>
                <div class="card sticker reveal">
                  <span class="when" style={`--c:var(--${s.color})`}>{s.when}</span>
                  <h3>{s.title}</h3>
                  <p class="place">{s.place.split(' · ').map((part, k) => <>{k > 0 && <span class="sep">•</span>}<span class="nowrap">{part}</span></>)}</p>
                  {s.meta && <p class="meta">✦ {s.meta}</p>}
                  {s.takeaway && <p class="takeaway" style={`--c:var(--${s.color})`}>{s.takeaway}</p>}
                  {s.visible && s.visible.map((para) => <p class="visible">{para}</p>)}
                  {s.story && (
                    <details>
                      <summary>the full story</summary>
                      <div class="journal">
                        {s.story.map((para) => <p>{para}</p>)}
                      </div>
                    </details>
                  )}
                  {s.more && <a class="more" href={s.more.href}>{s.more.label} →</a>}
                </div>
              </article>
            );
          })}
        </section>
      ))}

      {thread && (
        <div class="thread sticker reveal">
          <span class="tape" style="--c:var(--peach)"></span>
          <span class="label">the thread</span>
          <p>{thread}</p>
        </div>
      )}

      <div class="end reveal">
        <Doodle name="sparkle" color="butter" size={40} />
        <p class="tbc">to be continued…</p>
        <p>The next stop hasn't been drawn yet.</p>
      </div>
    </div>
  </div>
</Base>

<script>
  // the little cat walks down the path as you scroll
  const path = document.getElementById('path')!;
  const walker = document.getElementById('walker')!;
  function move() {
    const r = path.getBoundingClientRect();
    const progress = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
    walker.style.top = `${progress * (r.height - 60)}px`;
    walker.classList.toggle('flip', Math.floor(progress * 40) % 2 === 0); // little waddle
  }
  addEventListener('scroll', move, { passive: true });
  addEventListener('resize', move);
  move();
</script>

<style>
  .page-intro.intro-2 { margin-top: 14px; }
  .page-intro a { text-decoration: underline wavy; text-underline-offset: 5px; }
  .path { position: relative; margin-top: 70px; padding-bottom: 20px; }
  /* the dashed trail down the middle */
  .path::before {
    content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 0;
    border-left: 5px dashed var(--ink); opacity: .3; transform: translateX(-50%);
  }
  .walker { position: absolute; left: 50%; top: 0; z-index: 3; transform: translateX(-50%); transition: top .15s linear; pointer-events: none; }
  .walker :global(.cat) { display: block; transition: transform .2s; }
  .walker.flip :global(.cat) { transform: rotate(-8deg); }
  .walker:not(.flip) :global(.cat) { transform: rotate(8deg); }

  /* chapter labels sit on the trail */
  .chapter { position: relative; padding-top: 40px; }
  .chapter-label {
    position: relative; z-index: 2; width: min(520px, 100%); margin: 30px auto 50px; text-align: center;
    background: var(--ink); color: var(--pink-soft); border-radius: 20px; padding: 26px 24px 20px;
    box-shadow: 6px 6px 0 var(--paper);
  }
  .chapter-label .tape { left: 50%; margin-left: -55px; }
  .chapter-label .label { opacity: .8; }
  .chapter-label h2 { font-family: var(--font-display); font-size: clamp(30px, 5vw, 44px); line-height: 1.05; }
  .chapter-label p { font-size: 20px; margin-top: 4px; }
  .chapter-label.in { transform: rotate(-1.5deg); }
  .chapter:nth-child(odd) .chapter-label.in { transform: rotate(1.5deg); }

  /* each stop: card | node | (empty), alternating */
  .stop { display: grid; grid-template-columns: 1fr 110px 1fr; align-items: start; margin-bottom: 46px; position: relative; }
  .node {
    grid-column: 2; grid-row: 1; justify-self: center; z-index: 2; width: 96px; height: 96px; border-radius: 50%;
    background: var(--paper); border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--ink);
    display: grid; place-items: center; margin-top: 10px;
  }
  .node.in { animation: bob 3s ease-in-out infinite; }
  .stop:nth-child(odd) .node.in { animation-delay: -1.5s; }
  @keyframes bob { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-6px) rotate(4deg); } }
  .card { grid-row: 1; padding: 30px 26px 22px; position: relative; }
  .stop.left .card { grid-column: 1; }
  .stop.right .card { grid-column: 3; }
  .stop.left .card.in { transform: rotate(-1deg); }
  .stop.right .card.in { transform: rotate(1deg); }
  /* little arrow pointing at the node */
  .card::after {
    content: ''; position: absolute; top: 46px; width: 22px; height: 22px; background: var(--paper);
    border: 3px solid var(--ink); transform: rotate(45deg);
  }
  .stop.left .card::after { right: -14px; border-left: 0; border-bottom: 0; }
  .stop.right .card::after { left: -14px; border-right: 0; border-top: 0; }

  .when {
    position: absolute; top: -16px; left: 22px; background: var(--c); border: 2.5px solid var(--ink); border-radius: 8px;
    padding: 0 12px; font-family: var(--font-display); font-weight: 600; font-size: 16px; transform: rotate(-3deg);
  }
  .card h3 { font-family: var(--font-display); font-size: 26px; line-height: 1.15; }
  .place { font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 1px; text-transform: uppercase; opacity: .7; line-height: 1.5; margin-top: 6px; }
  .place .nowrap { white-space: normal; }
  .meta { font-size: 17px; margin-top: 2px; opacity: .85; }
  /* the one line that's always visible: the "so what" of each stop */
  .takeaway {
    position: relative; margin-top: 14px; padding: 10px 14px 10px 16px; font-size: 21px; font-weight: 700; line-height: 1.4;
    background: color-mix(in srgb, var(--c) 45%, var(--paper)); border-left: 5px solid var(--c); border-radius: 4px 12px 12px 4px;
  }
  .visible { font-size: 19px; line-height: 1.5; margin-top: 12px; }
  .more { display: inline-block; margin-top: 12px; font-size: 17px; opacity: .8; text-decoration: underline; text-underline-offset: 4px; }
  .more:hover { opacity: 1; }
  .thread {
    position: relative; z-index: 2; width: min(640px, 100%); margin: 30px auto 0; padding: 30px 30px 24px; text-align: center;
    font-size: 22px; line-height: 1.5; transform: rotate(-1deg);
  }
  .thread .tape { left: 50%; margin-left: -55px; }
  .thread p { margin-top: 6px; }


  .end { position: relative; z-index: 2; text-align: center; padding-top: 30px; font-size: 21px; }
  .end .tbc { font-family: var(--font-display); font-weight: 700; font-size: 36px; }
  .end { background: #fbf3e8; }

  @media (max-width: 860px) {
    .path::before { left: 34px; }
    .walker { left: 34px; }
    .stop { grid-template-columns: 70px 1fr; }
    .node { grid-column: 1; width: 64px; height: 64px; justify-self: start; }
    .node :global(.doodle) { width: 44px; height: 44px; }
    .stop.left .card, .stop.right .card { grid-column: 2; margin-left: 14px; }
    .stop.left .card::after { right: auto; left: -14px; border: 3px solid var(--ink); border-right: 0; border-top: 0; }
    .chapter-label { margin-left: 0; }
  }
</style>
