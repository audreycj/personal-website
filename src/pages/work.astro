---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import { jobs } from '../data/resume';

const current = jobs.find((j) => j.end === 'Present');
---
<Base title="Work" description="Audrey's work experience: teaching, UI/UX design, software development, and admissions.">
  <div class="wrap">
    <h1 class="page-title">Work</h1>
    <p class="page-intro">
      From giving campus tours to designing apps to teaching IT.{' '}
      {current && <>Right now I'm a <mark style="--c:var(--butter)">{current.role}</mark> at {current.org.replace(/ \(.*\)/, '')}.</>}
    </p>

    <div class="folders">
      {jobs.map((j) => (
        <article class="folder reveal" style={`--c:var(--${j.color})`}>
          <div class="tab">
            <span>{j.start} – {j.end}</span>
            {j.end === 'Present' && <b class="now">now!</b>}
          </div>
          <div class="sheet">
            <aside class="side">
              <div class="badge"><Doodle name={j.doodle} color={j.color} size={74} /></div>
              <span class="chip">{j.type}</span>
              <span class="chip">{j.setup}</span>
              <p class="loc">{j.location}</p>
            </aside>
            <div class="main">
              <h2>{j.role}</h2>
              <p class="org">{j.org}</p>

              <h3 class="label">what i did</h3>
              <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>

              {j.skills && <>
                <h3 class="label">tools & skills</h3>
                <p class="skills">{j.skills.map((s) => <span class="skill">{s}</span>)}</p>
              </>}

              {j.story && (
                <details>
                  <summary>what i learned</summary>
                  <div class="journal">{j.story.map((p) => <p>{p}</p>)}</div>
                </details>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="more">Want the story in between? <a href="/journey">Walk the whole journey →</a></p>
  </div>
</Base>

<style>
  .folders { display: flex; flex-direction: column; gap: 70px; margin-top: 70px; }

  /* manila-folder look: a colored tab sitting on top of the sheet */
  .folder { position: relative; }
  .folder.in:nth-child(odd) { transform: rotate(-.6deg); }
  .folder.in:nth-child(even) { transform: rotate(.6deg); }
  .tab {
    display: inline-flex; align-items: center; gap: 10px; margin-left: 28px; padding: 6px 22px 10px;
    background: var(--c); border: 3px solid var(--ink); border-bottom: 0; border-radius: 14px 14px 0 0;
    font-family: var(--font-display); font-weight: 600; font-size: 17px; position: relative; top: 3px;
  }
  .now {
    background: var(--paper); border: 2.5px solid var(--ink); border-radius: 999px; padding: 0 10px; font-size: 14px;
    animation: wiggle 2s ease-in-out infinite;
  }
  @keyframes wiggle { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
  .sheet {
    display: grid; grid-template-columns: 200px 1fr; gap: 30px; padding: 30px 30px 26px;
    background: var(--paper); border: 3px solid var(--ink); border-radius: 0 20px 20px 20px; box-shadow: 7px 7px 0 var(--ink);
    border-top: 14px solid var(--c);
    box-shadow: 7px 7px 0 var(--ink), inset 0 3px 0 var(--ink);
  }

  .side { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .badge {
    width: 110px; height: 110px; border-radius: 50%; background: var(--c); border: 3px solid var(--ink);
    display: grid; place-items: center; box-shadow: 4px 4px 0 var(--ink); margin-bottom: 8px;
    transition: transform .4s cubic-bezier(.3,1.8,.5,1);
  }
  .badge :global(.doodle) { background: var(--paper); border-radius: 50%; }
  .folder:hover .badge { transform: rotate(-10deg) scale(1.05); }
  .side .chip { font-size: 15px; background: #fff; }
  .loc { font-size: 17px; line-height: 1.3; }

  .main h2 { font-family: var(--font-display); font-size: clamp(28px, 4vw, 38px); line-height: 1.05; }
  .org { font-size: 21px; opacity: .85; }
  .main .label { margin-top: 18px; display: block; }
  .main ul { margin: 6px 0 0 22px; font-size: 20px; line-height: 1.45; }
  .main li { margin-bottom: 4px; }
  .main li::marker { content: '✦  '; color: var(--line); font-size: 14px; }
  .skills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .skill {
    font-family: var(--font-display); font-weight: 600; font-size: 15px; background: var(--c);
    border: 2.5px solid var(--ink); border-radius: 8px; padding: 1px 10px;
  }
  .skill:nth-child(odd) { transform: rotate(-2deg); }
  .skill:nth-child(even) { transform: rotate(1.5deg); }

  .more { margin-top: 60px; font-size: 22px; text-align: center; }
  .more a { font-weight: 700; text-decoration: underline wavy; text-underline-offset: 5px; }

  @media (max-width: 760px) {
    .sheet { grid-template-columns: 1fr; gap: 16px; padding: 22px 20px; }
    .side { flex-direction: row; flex-wrap: wrap; align-items: center; }
    .badge { width: 80px; height: 80px; margin-bottom: 0; }
    .badge :global(.doodle) { width: 54px; height: 54px; }
    .loc { width: 100%; }
    .tab { margin-left: 14px; font-size: 15px; }
  }
</style>
