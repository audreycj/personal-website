---
// ==========================================================
// CONTACT: a message form (sent to my inbox by Web3Forms)
// plus LinkedIn and GitHub. The form key lives in src/data/site.ts.
// ==========================================================
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
import { site } from '../data/site';

const linkStyle: Record<string, { color: string; doodle: string; note: string }> = {
  LinkedIn: { color: 'sky', doodle: 'speech', note: 'work stuff and connections' },
  GitHub: { color: 'sage', doodle: 'laptop', note: 'code and projects' },
};
---
<Base title="Contact" description="Send Audrey a message, or find her on LinkedIn and GitHub.">
  <div class="wrap">
    <h1 class="page-title">Say<br />Hi!</h1>
    <p class="page-intro">
      Questions about a project, a collaboration idea, or just want to talk about cats? Leave me a note.
    </p>

    <div class="grid">
      <!-- THE FORM -->
      <form class="letter sticker reveal" id="contact-form" data-key={site.web3formsKey}>
        <span class="tape" style="--c:var(--peach)"></span>
        <span class="stamp" aria-hidden="true"><Doodle name="paw" color="peach" size={44} /></span>
        <h2>write me a note</h2>

        <label>
          <span>your name</span>
          <input name="name" type="text" required autocomplete="name" />
        </label>
        <label>
          <span>your email <small>(so I can reply)</small></span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label>
          <span>your message</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <!-- spam trap: real people never see or fill this -->
        <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" />

        <button type="submit" class="btn" style="--c:var(--peach)">send it →</button>
        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <!-- OTHER WAYS -->
      <aside class="elsewhere">
        <h2 class="label">or find me here</h2>
        {site.links.map((l) => {
          const st = linkStyle[l.label] ?? { color: 'butter', doodle: 'sparkle', note: '' };
          return (
            <a class="link-card sticker reveal" href={l.url} target="_blank" rel="noopener" style={`--c:var(--${st.color})`}>
              <span class="icon"><Doodle name={st.doodle} color={st.color} size={44} /></span>
              <span><b>{l.label} ↗</b>{st.note && <small>{st.note}</small>}</span>
            </a>
          );
        })}
        <p class="based">
          <Doodle name="sun" color="butter" size={30} /> based in Mati City, Davao Oriental, Philippines
        </p>
      </aside>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  const button = form.querySelector('button') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const key = form.dataset.key;
    if (!key) {
      status.textContent = "The form isn't connected yet. Please try LinkedIn for now!";
      status.className = 'status bad';
      return;
    }
    const data = Object.fromEntries(new FormData(form));
    button.disabled = true;
    status.textContent = 'sending...';
    status.className = 'status';
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...data,
          access_key: key,
          subject: `New message from ${data.name} (personal website)`,
          from_name: 'Personal website',
          botcheck: data.botcheck ? true : '',
        }),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      status.textContent = 'Sent! Thank you, I got your note.';
      status.className = 'status good';
    } catch {
      status.textContent = "Hmm, that didn't go through. Please try again, or reach me on LinkedIn.";
      status.className = 'status bad';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 50px; align-items: start; margin-top: 50px; }

  /* the form, styled like a letter on lined paper */
  .letter {
    position: relative; padding: 40px 36px 30px; display: flex; flex-direction: column; gap: 18px;
    background: var(--paper) repeating-linear-gradient(transparent 0 37px, rgba(61, 26, 34, .08) 37px 39px);
  }
  .letter.in { transform: rotate(-.8deg); }
  .letter h2 { font-family: var(--font-display); font-size: 30px; }
  .stamp {
    position: absolute; top: 22px; right: 24px; padding: 8px; background: var(--cream);
    border: 2.5px dashed var(--ink); border-radius: 6px; transform: rotate(6deg);
  }
  label { display: flex; flex-direction: column; gap: 6px; }
  label > span { font-family: var(--font-display); font-weight: 600; font-size: 15px; text-transform: uppercase; letter-spacing: .8px; }
  label small { text-transform: none; letter-spacing: 0; font-weight: 400; opacity: .7; font-size: 15px; }
  input, textarea {
    font: inherit; font-size: 20px; color: var(--ink); padding: 10px 14px; background: #fff;
    border: 2.5px solid var(--ink); border-radius: 12px; box-shadow: 3px 3px 0 var(--ink); resize: vertical;
  }
  input:focus, textarea:focus { outline: none; background: var(--cream); box-shadow: 4px 4px 0 var(--ink); }
  .trap { position: absolute; left: -9999px; }
  .letter .btn { align-self: flex-start; margin-top: 6px; cursor: pointer; }
  .letter .btn:disabled { opacity: .6; cursor: wait; }
  .status { font-size: 19px; min-height: 1.4em; }
  .status.good { color: #4a6b40; font-weight: 700; }
  .status.bad { color: #a0394f; font-weight: 700; }

  /* other ways */
  .elsewhere { display: flex; flex-direction: column; gap: 22px; }
  .link-card {
    display: flex; align-items: center; gap: 16px; padding: 18px 22px; background: var(--c);
    transition: transform .3s cubic-bezier(.3,1.6,.5,1);
  }
  .link-card:nth-of-type(odd).in { transform: rotate(1deg); }
  .link-card:nth-of-type(even).in { transform: rotate(-1deg); }
  .link-card:hover { transform: translateY(-4px) rotate(0); }
  .link-card .icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: var(--paper); border: 2.5px solid var(--ink); flex: none; }
  .link-card b { display: block; font-family: var(--font-display); font-size: 24px; }
  .link-card small { font-size: 18px; }
  .based { display: flex; align-items: center; gap: 10px; font-size: 19px; margin-top: 8px; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .letter { padding: 36px 22px 26px; }
  }
</style>
